# Copy this file to .env.local for local dev, and add the same keys
# in Vercel -> Project -> Settings -> Environment Variables for deployment.

# --- MongoDB ---
# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=your_mongodb_atlas_connection_string_here

# --- Gemini AI ---
# Get a key at https://aistudio.google.com/apikey
# NEVER hardcode this in source or commit it -- set it as an env var only.
#
# KNOWN ISSUE (as of mid-2026): Google AI Studio has been issuing some keys
# with an "AQ." prefix (instead of the classic "AIza..." format). These
# AQ.-prefixed keys are currently rejected by generativelanguage.googleapis.com
# with 401 ACCESS_TOKEN_TYPE_UNSUPPORTED / "Expected OAuth 2 access token" --
# a bug on Google's side, not this app. If you hit that error, regenerate a
# key (ideally in a fresh AI Studio project) and confirm it starts with
# "AIza". If every key you generate still comes back as "AQ." and still
# fails, this app degrades gracefully (routing/reporting keep working, AI
# insights just show as unavailable) until Google resolves it.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Note: this is a demo build -- the /admin dashboard has no login gate.

# --- (Optional) Self-hosted OSRM routing server ---
# Leave empty to use the free public demo server (https://router.project-osrm.org).
# The public demo is fine for development/testing but is rate-limited and NOT
# meant for production traffic -- self-host OSRM (Docker image is official and
# easy to run) and put its URL here once you're ready to go to production.
NEXT_PUBLIC_OSRM_URL=
