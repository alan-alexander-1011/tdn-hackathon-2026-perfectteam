# Copy this file to .env.local for local dev, and add the same keys
# in Vercel → Project → Settings → Environment Variables for deployment.

# --- Google Maps ---
# Must be prefixed NEXT_PUBLIC_ because it's read in the browser (app/page.tsx).
# This is the key your friend already got working.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Map ID from Google Cloud Console (Maps > Map Management).
# Required for AdvancedMarker to render. Replace the "DEMO_MAP_ID" placeholder
# in app/page.tsx with this same value once you have it.
NEXT_PUBLIC_GOOGLE_MAPS_ID=your_map_id_here

# --- MongoDB ---
# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=your_mongodb_atlas_connection_string_here

# --- Python AI Backend ---
# Base URL of your deployed Python service (no trailing slash)
PYTHON_BACKEND_URL=https://your-python-backend.example.com
